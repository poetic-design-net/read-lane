# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# App host (dashboard, create, share links) — no trailing slash
# Production: https://app.readlane.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketing landing (readlane.io). Optional locally — defaults to APP_URL.
# Production: https://readlane.io
# NEXT_PUBLIC_MARKETING_URL=https://readlane.io

# Branding
NEXT_PUBLIC_APP_NAME=Readlane
NEXT_PUBLIC_APP_DESCRIPTION=Markdown schön teilen.
NEXT_PUBLIC_CLI_NAME=readlane
NEXT_PUBLIC_CLI_PACKAGE=@readlane/cli

# Session signing secret (min 32 chars, random)
SESSION_SECRET=replace-with-long-random-string

# Max stored versions per document (Pro+)
MAX_VERSIONS_PER_DOCUMENT=50

# Local object storage root for PDF/images (dev)
# STORAGE_LOCAL_PATH=.data/storage

# Stripe (Pro / Business)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_YEARLY_PRICE_ID=
# STRIPE_BUSINESS_MONTHLY_PRICE_ID=
# STRIPE_BUSINESS_YEARLY_PRICE_ID=

# CLI / CI token (never commit real tokens)
# READLANE_TOKEN=
# READLANE_API_URL=http://localhost:3000

# Seed script (optional)
# SEED_EMAIL=demo@example.com
# SEED_PASSWORD=demopassword
