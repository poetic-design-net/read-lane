# ─── Core (required) ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session signing secret (min 32 chars, random, crypto-secure)
SESSION_SECRET=replace-with-long-random-string-at-least-32-chars

# App host (dashboard, create, share links) — no trailing slash
# Production: https://app.readlane.io
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Marketing landing (readlane.io). Optional locally — defaults to APP_URL.
# NEXT_PUBLIC_MARKETING_URL=https://readlane.io

# Branding
NEXT_PUBLIC_APP_NAME=Readlane
NEXT_PUBLIC_APP_DESCRIPTION=Markdown schön teilen.
NEXT_PUBLIC_CLI_NAME=readlane
NEXT_PUBLIC_CLI_PACKAGE=@readlane/cli

# ─── Object storage ───────────────────────────────────────────────────────────
# local | vercel-blob | s3
STORAGE_PROVIDER=local
# STORAGE_LOCAL_PATH=.data/storage
# BLOB_READ_WRITE_TOKEN=
# FILE_SIGNING_SECRET=

# ─── Stripe (Pro / Business) ──────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRO_MONTHLY_PRICE_ID=
# STRIPE_PRO_YEARLY_PRICE_ID=
# STRIPE_BUSINESS_MONTHLY_PRICE_ID=
# STRIPE_BUSINESS_YEARLY_PRICE_ID=

# ─── Email (optional) ─────────────────────────────────────────────────────────
# EMAIL_FROM=Readlane <noreply@readlane.app>
# EMAIL_PROVIDER_API_KEY=

# ─── Secrets / workers ────────────────────────────────────────────────────────
# CLI_DEVICE_CODE_SECRET=
# SENTRY_DSN=
# CRON_SECRET=
# INTERNAL_WORKER_SECRET=

# Max stored versions per document (Pro+)
MAX_VERSIONS_PER_DOCUMENT=50

# CLI / CI token (never commit real tokens)
# READLANE_TOKEN=
# READLANE_API_URL=http://localhost:3000

# Seed script (local only — never production passwords)
# SEED_EMAIL=alex@readlane.app
# SEED_PASSWORD=local-dev-only-password
